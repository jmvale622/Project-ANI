<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ani_cream_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="50dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/ani_dark_green"
            android:textSize="24sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="@color/ani_dark_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textColor="@color/ani_dark_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_signup_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:hint="e.g. Ver Santos"
                android:textColorHint="@color/text_hint"
                android:textColor="#2C2C2C"
                android:inputType="textPersonName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHONE NUMBER"
                android:textColor="@color/ani_dark_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="20dp" />

            <EditText
                android:id="@+id/etContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_signup_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:hint="+63 917 000 0000"
                android:textColorHint="@color/text_hint"
                android:textColor="#2C2C2C"
                android:inputType="phone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOWN / MUNICIPALITY (BATANGAS)"
                android:textColor="@color/ani_dark_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvCityDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_signup_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:layout_marginTop="8dp"
                android:textSize="15sp"
                android:text="Select Town / Municipality"
                android:textColor="@color/ani_dark_green"
                app:drawableEndCompat="@android:drawable/arrow_down_float"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BARANGAY"
                android:textColor="@color/ani_dark_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvBarangayDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_signup_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:layout_marginTop="8dp"
                android:textSize="15sp"
                android:text="Select Barangay"
                android:textColor="@color/ani_dark_green"
                app:drawableEndCompat="@android:drawable/arrow_down_float"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CROPS"
                android:textColor="@color/ani_dark_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/layoutCropsDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_signup_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvSelectedCrops"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select crops"
                    android:textSize="15sp"
                    android:textColor="@color/ani_dark_green" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/text_hint"
                    android:contentDescription="@string/app_name" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You can choose more than one."
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PLOTS"
                        android:textColor="@color/ani_dark_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <EditText
                        android:id="@+id/etPlots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_signup_input"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp"
                        android:layout_marginTop="8dp"
                        android:textSize="16sp"
                        android:hint="e.g. 3"
                        android:textColorHint="@color/text_hint"
                        android:textColor="#2C2C2C"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HECTARES"
                        android:textColor="@color/ani_dark_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <EditText
                        android:id="@+id/etHectares"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_signup_input"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="16dp"
                        android:layout_marginTop="8dp"
                        android:textSize="16sp"
                        android:hint="e.g. 0.8"
                        android:textColorHint="@color/text_hint"
                        android:textColor="#2C2C2C"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LANGUAGE"
                android:textColor="@color/ani_dark_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvLanguageDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_signup_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:text="English"
                android:textColor="#2C2C2C"
                app:drawableEndCompat="@android:drawable/arrow_down_float"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATE A PIN"
                android:textColor="@color/ani_dark_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="24dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_signup_input"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:hint=". . . ."
                android:textColorHint="@color/text_hint"
                android:textColor="#2C2C2C"
                android:inputType="numberPassword"
                android:letterSpacing="1.2" />

            <!-- Terms & Conditions Notice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/tvTermsLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="By continuing, you agree to ANI's Terms &amp; Conditions."
                    android:textColor="@color/ani_dark_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSignUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_primary_button"
                android:text="Continue"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="17sp"
                android:paddingVertical="16dp"
                android:layout_marginTop="32dp"
                android:textAllCaps="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="#666666"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/tvGoToSignIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in"
                    android:textColor="@color/ani_dark_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>