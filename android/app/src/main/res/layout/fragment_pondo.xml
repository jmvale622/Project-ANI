<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ani_cream_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Funds"
            android:textColor="@color/ani_dark_green"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <ImageButton
            android:id="@+id/btnHelp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_squircle_button"
            android:src="@drawable/ic_help_question"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="@string/app_name" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="noHideDescendants">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Financing and insurance for your farm,\nboth facilitated through ANI."
                    android:textColor="#7A7568"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />

            <!-- ANILoan Card -->
            <FrameLayout
                android:id="@+id/cardAniLoan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stats_card"
                android:backgroundTint="#FAF7F0"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Top Right Quarter Circle Decorative Accent -->
                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="top|end"
                    android:src="@drawable/bg_card_quarter_circle"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_container"
                            android:backgroundTint="@color/ani_khaki">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰"
                                android:textSize="22sp"
                                android:layout_gravity="center" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ANILoan"
                                android:textColor="@color/ani_dark_green"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:fontFamily="serif" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/aniloan_desc"
                                android:textColor="#7A7568"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp"
                        android:gravity="bottom">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ELIGIBLE AMOUNT"
                                android:textColor="#7A7568"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱6,500"
                                android:textColor="@color/ani_dark_green"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:fontFamily="serif" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnOpenLoan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="90dp"
                            android:minHeight="40dp"
                            android:background="@drawable/bg_orange_button"
                            android:text="Open →"
                            android:textColor="@color/ani_dark_green"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:paddingHorizontal="20dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ANI Protect Card -->
            <FrameLayout
                android:id="@+id/cardAniProtect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stats_card"
                android:backgroundTint="@color/white"
                android:layout_marginBottom="28dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_container"
                            android:backgroundTint="#F5F1E9">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🛡️"
                                android:textSize="22sp"
                                android:layout_gravity="center" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ANI Protect"
                                android:textColor="@color/ani_dark_green"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:fontFamily="serif" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Crop insurance cover"
                                android:textColor="#7A7568"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp"
                        android:gravity="bottom">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COVERAGE"
                                android:textColor="#7A7568"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₱15,000"
                                android:textColor="@color/ani_dark_green"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:fontFamily="serif" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnOpenProtect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="90dp"
                            android:minHeight="40dp"
                            android:background="@drawable/bg_primary_button"
                            android:text="Open →"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:paddingHorizontal="20dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALREADY ACTIVE"
                android:textColor="#7A7568"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <!-- Active loan item -->
            <LinearLayout
                android:id="@+id/itemActiveLoan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stats_card"
                android:backgroundTint="@color/white"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active loan"
                        android:textColor="@color/ani_dark_green"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱4,200 remaining · due Aug 15"
                        android:textColor="#7A7568"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#CCCCCC"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Insurance claim item -->
            <LinearLayout
                android:id="@+id/itemInsuranceClaim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stats_card"
                android:backgroundTint="@color/white"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="40dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="File an insurance claim"
                        android:textColor="@color/ani_dark_green"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#CCCCCC"
                    android:textSize="20sp" />
            </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99D9D9D9"
            android:clickable="true"
            android:contentDescription="@string/funds_coming_soon"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_stats_card"
                android:backgroundTint="@color/white"
                android:elevation="4dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:text="@string/funds_coming_soon"
                android:textColor="@color/text_gray"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>