<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:clipToPadding="false"
    android:focusableInTouchMode="true"
    android:background="@color/ani_cream_bg">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ani_cream_bg"
    android:padding="28dp">

    <!-- Image Preview Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#2E2820"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        app:layout_constraintWidth_percent="0.85">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivAnalysisPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_name" />

            <!-- Scanning Line Overlay -->
            <View
                android:id="@+id/vScanLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/bg_scan_line"
                android:layout_gravity="center_vertical" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Title Section -->
    <TextView
        android:id="@+id/tvAnalysisTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analyzing the photo..."
        android:textColor="@color/ani_dark_green"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/cardPreview"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvAnalysisSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Please keep the app open. Just a few seconds more."
        android:textColor="#7A7568"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvAnalysisTitle" />

    <!-- Progress Steps Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvAnalysisSubtitle">

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">
            <View
                android:id="@+id/dotStep1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_step_solid" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo quality — OK"
                android:textColor="@color/ani_dark_green"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="14dp" />
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">
            <View
                android:id="@+id/dotStep2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_step_hollow" />
            <TextView
                android:id="@+id/tvStep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOLOv11 detection — running"
                android:textColor="#7A7568"
                android:textSize="14sp"
                android:layout_marginStart="14dp" />
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">
            <View
                android:id="@+id/dotStep3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_step_hollow" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confidence score"
                android:textColor="#7A7568"
                android:textSize="14sp"
                android:layout_marginStart="14dp" />
        </LinearLayout>

        <!-- Step 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:id="@+id/dotStep4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_step_hollow" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI recommendation"
                android:textColor="#7A7568"
                android:textSize="14sp"
                android:layout_marginStart="14dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>